# Site access: 'public' or 'protected' (password gate for staging)
PUBLIC_SITE_ACCESS='public'

# Supabase settings
PUBLIC_SUPABASE_URL='https://REPLACE_ME.supabase.co'
PUBLIC_SUPABASE_ANON_KEY='REPLACE_ME'
PRIVATE_SUPABASE_SERVICE_ROLE='REPLACE_ME'

# Stripe settings
PRIVATE_STRIPE_API_KEY='REPLACE_ME'

# Optional - settings for email

# Email address admin messages will be sent to
# PRIVATE_ADMIN_EMAIL='your_email@example.com'
# Email address messages will be sent from
# PRIVATE_FROM_ADMIN_EMAIL='no_reply@example.com'
# Resend API key
# PRIVATE_RESEND_API_KEY='your_resend_api_key'
# Chatwoot live-chat widget (chat.buoy.fish). Both must be set or the widget
# stays inert (src/lib/ChatWidget.svelte). Set in prod via wrangler.toml [vars],
# not the Pages dashboard — a wrangler config file makes dashboard vars inert.
# PUBLIC_CHATWOOT_BASE_URL='https://chat.buoy.fish'
# PUBLIC_CHATWOOT_TOKEN='website inbox token from the Chatwoot dashboard'

# Cloudflare Turnstile on /contact_us and /propose. The site only renders the
# widget; app.buoy.fish verifies the token (ADR-0039). Cloudflare's always-pass
# test site key is fine for local dev. Production: the PUBLIC_TURNSTILE_SITE_KEY
# GitHub repo variable (baked in at build).
PUBLIC_TURNSTILE_SITE_KEY='1x00000000000000000000AA'

# Both forms post their lead to app.buoy.fish/api/v1/site/leads with this bearer
# token (ADR-0039). Unset = every submission fails loudly with the "email
# hello@buoy.fish" fallback. Production: a Pages secret, sourced from bao
# secret/BUOY.fish/deploy PRIVATE_SITE_LEADS_TOKEN (same value as the app's
# secret/app/site-leads token).
# PRIVATE_SITE_LEADS_TOKEN=''
